[Unit]
Description=Read-only LDAP GAL bridge (Thunderbird address book)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/bin/ldapgal.py
Restart=on-failure
RestartSec=3
Environment=EWS_BRIDGE_PATH=%h/bin/ews_bridge.py
Environment=LDAP_BASE_DN=dc=example,dc=com

[Install]
WantedBy=default.target
